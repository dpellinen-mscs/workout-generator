{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dpellinen-mscs/workout-generator/eval/schema/case-file.schema.json",
  "title": "Workout constraint case file",
  "type": "object",
  "required": [
    "format_version",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "type": "integer",
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "equipment": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "barbell",
          "dumbbell",
          "kettlebell",
          "cable",
          "machine",
          "band",
          "med_ball",
          "bodyweight",
          "other"
        ]
      }
    },
    "athlete": {
      "type": "object",
      "required": [
        "position",
        "goal",
        "phase",
        "days_per_week",
        "injuries"
      ],
      "properties": {
        "position": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "enum": [
            "power",
            "speed",
            "hypertrophy",
            "general"
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "offseason",
            "inseason"
          ]
        },
        "days_per_week": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "injuries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "equipment": {
          "$ref": "#/$defs/equipment"
        }
      },
      "additionalProperties": false
    },
    "expect": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "all_exercises_use_only": {
          "$ref": "#/$defs/equipment"
        },
        "library_categories_nonempty": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "day_count_equals": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "sessions_distinct": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "no_session_after_limit": {
          "type": "boolean",
          "const": true
        },
        "fallback_full_body": {
          "type": "boolean",
          "const": true
        },
        "no_excluded_exercises": {
          "type": "string",
          "enum": [
            "shoulder",
            "elbow",
            "knee",
            "back",
            "hip"
          ]
        },
        "main_lifts_avoid_history": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "lower",
              "upper_push",
              "upper_pull"
            ]
          }
        },
        "accessory_pair_differs_from_previous": {
          "type": "boolean",
          "const": true
        },
        "repeated_run_equals": {
          "type": "boolean",
          "const": true
        },
        "main_lift_names": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "lower": {
              "type": "string",
              "minLength": 1
            },
            "upper_push": {
              "type": "string",
              "minLength": 1
            },
            "upper_pull": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "tags",
        "athlete",
        "history",
        "day_index",
        "expect"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "athlete": {
          "$ref": "#/$defs/athlete"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "day_index": {
          "type": "integer",
          "minimum": 0
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "finding": {
          "type": "string",
          "pattern": "^F-[0-9]{3}$"
        },
        "notes": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "focus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "scenario": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "single",
                "days",
                "injury_filter",
                "rotation"
              ]
            }
          }
        }
      }
    }
  }
}
